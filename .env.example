# Ejemplo sin secretos. Copiar a .env local o agregar pares en Render.
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Selección explícita: groq (predeterminado) o deepseek (pago por consumo).
IA_PROVEEDOR=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODELO_VISION=deepseek-flash
DEEPSEEK_MODELO_TEXTO=deepseek-flash
# Para volver a Groq, seleccionar IA_PROVEEDOR=groq y configurar:
# GROQ_API_KEY=tu_clave
# GROQ_MODELO_VISION=identificador_de_un_modelo_con_imagenes_disponible
# GROQ_MODELO_TEXTO=identificador_de_un_modelo_con_JSON_disponible

# Dictado por voz (opcional). Usa Whisper en Groq con GROQ_API_KEY, aunque IA_PROVEEDOR sea deepseek.
# Sin GROQ_API_KEY el bot funciona igual, sin notas de voz.
# GROQ_API_KEY=tu_clave
# GROQ_MODELO_VOZ=whisper-large-v3-turbo
# Si Groq retira el modelo, cambia de proveedor sin tocar código (cualquier servicio compatible con
# la API de OpenAI /audio/transcriptions). Con VOZ_BASE_URL deben ir también VOZ_API_KEY y VOZ_MODELO:
# VOZ_BASE_URL=https://api.tu-proveedor.com/v1
# VOZ_API_KEY=
# VOZ_MODELO=
# VOZ_MAX_SEGUNDOS=60
# VOZ_ACTIVADA=No   # apaga la voz aunque exista GROQ_API_KEY (déjalo sin definir para usarla)

MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SITE_ID=
MS_DRIVE_ID=

# Solo para el modo tradicional de un destino.
MS_ITEM_ID=
MS_TABLE_NAME=REGISTRODIARIO3
MS_USUARIOS_ITEM_ID=
FORMATO_FECHA_EXCEL=PE

# Completar activa el modo de proyectos. Vacío conserva el modo tradicional.
# ID del Excel central, dentro de MS_DRIVE_ID; puede ser Accesos.xlsx ampliado.
MS_CONFIG_ITEM_ID=

# Evidencias (solo modo de proyectos): copia de la foto original de cada operación registrada en
# <MS_EVIDENCIAS_RUTA>/<Nombre del proyecto>/, dentro de la biblioteca del Excel del proyecto.
# MS_EVIDENCIAS_RUTA=Finanzas/Evidencias
# MS_EVIDENCIAS_DRIVE_ID=   # otra biblioteca para las evidencias (vacío = la del Excel del proyecto)
